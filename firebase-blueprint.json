{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents the customer's primary profile, avatar, role, legal account type, subscription tier, notification preferences, and current wallet balance.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique Firebase Auth UID of the user."
        },
        "fullName": {
          "type": "string",
          "maxLength": 150,
          "description": "Full Arabic name of the user."
        },
        "firstName": {
          "type": "string",
          "maxLength": 60,
          "description": "First name."
        },
        "fatherName": {
          "type": "string",
          "maxLength": 60,
          "description": "Father name."
        },
        "grandfatherName": {
          "type": "string",
          "maxLength": 60,
          "description": "Grandfather name."
        },
        "familyName": {
          "type": "string",
          "maxLength": 80,
          "description": "Family or clan surname."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 100,
          "description": "Registered email address."
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Contact phone number."
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 350000,
          "description": "Uploaded profile avatar URL or data URI."
        },
        "accountType": {
          "type": "string",
          "enum": ["individual", "record_keeper"],
          "description": "Legal status: Individual (فرد) or Family Record Keeper (أمين السجل)."
        },
        "defaultCountry": {
          "type": "string",
          "maxLength": 60,
          "description": "Default residence country."
        },
        "originCountry": {
          "type": "string",
          "maxLength": 60,
          "description": "Country of ancestral origin."
        },
        "originRegion": {
          "type": "string",
          "maxLength": 100,
          "description": "Region or city of ancestral origin."
        },
        "tribeName": {
          "type": "string",
          "maxLength": 100,
          "description": "Tribe name if known."
        },
        "familyBranch": {
          "type": "string",
          "maxLength": 100,
          "description": "Family branch (الفخذ / الفرع)."
        },
        "subscriptionTier": {
          "type": "string",
          "enum": ["free", "basic_verified", "premium_annual"],
          "description": "Current subscription tier: Free, Basic ($5 verified root), or Premium Annual ($60/yr)."
        },
        "walletBalance": {
          "type": "number",
          "description": "Available wallet credit balance in USD."
        },
        "isRootUnlocked": {
          "type": "boolean",
          "description": "Whether the $5 connection root is unlocked."
        },
        "emailNotificationsEnabled": {
          "type": "boolean",
          "description": "Whether email notifications for research tickets and family tree updates are enabled."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of registration."
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of last profile update."
        }
      },
      "required": ["userId", "fullName", "email", "accountType", "subscriptionTier", "walletBalance", "createdAt"]
    },
    "FamilyTreeDocument": {
      "title": "FamilyTreeDocument",
      "description": "Stores the interactive family tree nodes (شجرتي) for a customer.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID."
        },
        "familyName": {
          "type": "string",
          "maxLength": 100,
          "description": "Family name."
        },
        "peopleJson": {
          "type": "string",
          "maxLength": 500000,
          "description": "Serialized interactive tree nodes."
        },
        "updatedAt": {
          "type": "string",
          "description": "Last modification timestamp."
        }
      },
      "required": ["userId", "familyName", "peopleJson", "updatedAt"]
    },
    "CustomerOrder": {
      "title": "CustomerOrder",
      "description": "Represents a real customer lineage search & subscription order visible in the /Team Operations Hub.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique order ID."
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Customer UID."
        },
        "fullName": {
          "type": "string",
          "maxLength": 150,
          "description": "Full customer name."
        },
        "firstName": {
          "type": "string",
          "maxLength": 60,
          "description": "First name."
        },
        "fatherName": {
          "type": "string",
          "maxLength": 60,
          "description": "Father name."
        },
        "grandfatherName": {
          "type": "string",
          "maxLength": 60,
          "description": "Grandfather name."
        },
        "familyName": {
          "type": "string",
          "maxLength": 80,
          "description": "Family name."
        },
        "originCountry": {
          "type": "string",
          "maxLength": 60,
          "description": "Origin country."
        },
        "originRegion": {
          "type": "string",
          "maxLength": 100,
          "description": "Origin region."
        },
        "email": {
          "type": "string",
          "maxLength": 100,
          "description": "Customer email."
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Customer phone."
        },
        "legalRole": {
          "type": "string",
          "enum": ["individual", "record_keeper"],
          "description": "Legal account role."
        },
        "accountStatus": {
          "type": "string",
          "enum": ["free", "paid_5_root", "annual_vip"],
          "description": "Subscription status."
        },
        "walletBalanceUsd": {
          "type": "number",
          "description": "Current wallet balance."
        },
        "paidRevenueUsd": {
          "type": "number",
          "description": "Total revenue paid in USD."
        },
        "matchStatus": {
          "type": "string",
          "enum": ["auto_adam_full", "staged_3_nodes", "pending_geo_clarification", "open_research_ticket", "enriched_delivered"],
          "description": "Lineage match status."
        },
        "ticketId": {
          "type": "string",
          "maxLength": 40,
          "description": "Associated ticket ID."
        },
        "ticketType": {
          "type": "string",
          "maxLength": 60,
          "description": "Ticket classification."
        },
        "assignedResearcher": {
          "type": "string",
          "maxLength": 120,
          "description": "Assigned researcher name."
        },
        "slaStatus": {
          "type": "string",
          "maxLength": 80,
          "description": "SLA lifecycle status."
        },
        "nodesCountLabel": {
          "type": "string",
          "maxLength": 160,
          "description": "Summary of lineage nodes."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp."
        }
      },
      "required": ["id", "fullName", "familyName", "email", "accountStatus", "matchStatus", "createdAt"]
    },
    "ResearchTicket": {
      "title": "ResearchTicket",
      "description": "Genealogical investigation or enrichment ticket stored in Firebase and processed in Researcher Studio.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-#]+$",
          "description": "Unique ticket ID."
        },
        "ticketNumber": {
          "type": "string",
          "maxLength": 40,
          "description": "Human-readable sequential ticket code."
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the user who owns this search ticket."
        },
        "userFullName": {
          "type": "string",
          "maxLength": 150,
          "description": "Name of the requesting customer."
        },
        "userEmail": {
          "type": "string",
          "maxLength": 100,
          "description": "Customer contact email."
        },
        "userPhone": {
          "type": "string",
          "maxLength": 30,
          "description": "Customer contact phone."
        },
        "targetAncestor": {
          "type": "string",
          "maxLength": 200,
          "description": "Target lineage chain supplied by customer."
        },
        "tribeName": {
          "type": "string",
          "maxLength": 100,
          "description": "Target tribe or clan."
        },
        "familyBranch": {
          "type": "string",
          "maxLength": 100,
          "description": "Family branch or known region."
        },
        "originCountry": {
          "type": "string",
          "maxLength": 60,
          "description": "Country of origin."
        },
        "additionalNotes": {
          "type": "string",
          "maxLength": 2000,
          "description": "Family oral history notes or corroborating evidence summary."
        },
        "status": {
          "type": "string",
          "enum": ["pending_review", "investigating", "lineage_found", "completed", "no_records_found", "CLOSED_AND_ENRICHED"],
          "description": "Current lifecycle status of genealogical research."
        },
        "assignedResearcherId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the genealogical researcher assigned to the case."
        },
        "assignedResearcherName": {
          "type": "string",
          "maxLength": 150,
          "description": "Display name of the genealogist."
        },
        "researchFindings": {
          "type": "string",
          "maxLength": 5000,
          "description": "Genealogist's findings and verified lineage chain."
        },
        "verifiedSources": {
          "type": "string",
          "maxLength": 3000,
          "description": "Citations of historical documents."
        },
        "studioPayloadJson": {
          "type": "string",
          "maxLength": 100000,
          "description": "Serialized ResearcherStudioTicket payload if applicable."
        },
        "clientNotified": {
          "type": "boolean",
          "description": "Whether notification has been dispatched to the client."
        },
        "openedAt": {
          "type": "string",
          "description": "Timestamp when ticket was created."
        },
        "resolvedAt": {
          "type": "string",
          "description": "Timestamp when research was concluded."
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of last modification."
        }
      },
      "required": ["id", "ticketNumber", "userId", "userFullName", "targetAncestor", "status", "openedAt"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Financial ledger entry for user wallet balance changes.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique transaction ID."
        },
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of user."
        },
        "type": {
          "type": "string",
          "enum": ["credit", "debit"],
          "description": "Credit or Debit."
        },
        "amount": {
          "type": "number",
          "description": "Amount in USD."
        },
        "reason": {
          "type": "string",
          "maxLength": 200,
          "description": "Description of transaction."
        },
        "referenceId": {
          "type": "string",
          "maxLength": 100,
          "description": "Reference ID."
        },
        "balanceAfter": {
          "type": "number",
          "description": "User wallet balance after this transaction."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of the transaction."
        }
      },
      "required": ["id", "userId", "type", "amount", "reason", "balanceAfter", "createdAt"]
    },
    "CustomerNotification": {
      "title": "CustomerNotification",
      "description": "Proactive customer support message, feature announcement, or ticket status update sent to a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique notification ID."
        },
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of recipient user."
        },
        "title": {
          "type": "string",
          "maxLength": 150,
          "description": "Notification headline."
        },
        "body": {
          "type": "string",
          "maxLength": 1000,
          "description": "Message body."
        },
        "category": {
          "type": "string",
          "enum": ["ticket_update", "feature_announcement", "wallet_bonus", "system_notice"],
          "description": "Category of the notification."
        },
        "actionUrl": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional in-app route or action identifier."
        },
        "actionLabel": {
          "type": "string",
          "maxLength": 60,
          "description": "Optional CTA button label."
        },
        "isRead": {
          "type": "boolean",
          "description": "Read status."
        },
        "senderRole": {
          "type": "string",
          "enum": ["system", "support", "researcher"],
          "description": "Role of the message sender."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of dispatch."
        }
      },
      "required": ["id", "userId", "title", "body", "category", "isRead", "createdAt"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Isolated /Team staff and admin member record with strict RBAC roles.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique team member ID."
        },
        "name": {
          "type": "string",
          "maxLength": 120,
          "description": "Full Arabic name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120,
          "description": "Work email address."
        },
        "passwordHash": {
          "type": "string",
          "maxLength": 120,
          "description": "Credential for /Team portal authentication."
        },
        "role": {
          "type": "string",
          "enum": ["المايسترو", "مدير عام", "مدير البحوث", "مدير إدارة الطلبات وخدمة العملاء", "مدير تحرير المركز المعرفي"],
          "description": "Strict RBAC role in /Team."
        },
        "status": {
          "type": "string",
          "enum": ["نشط", "موقوف"],
          "description": "Account status."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp."
        }
      },
      "required": ["id", "name", "email", "role", "status", "createdAt"]
    },
    "KnowledgeArticle": {
      "title": "KnowledgeArticle",
      "description": "Article or genealogical study published in the Juthori Knowledge Center (المركز المعرفي).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Article ID."
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Article title."
        },
        "category": {
          "type": "string",
          "maxLength": 80,
          "description": "Article category (e.g. تحقيق المصادر, ميثاق أمين السجل, دراسات الأنساب)."
        },
        "summary": {
          "type": "string",
          "maxLength": 500,
          "description": "Brief summary displayed on cards."
        },
        "content": {
          "type": "string",
          "maxLength": 20000,
          "description": "Full article content."
        },
        "authorName": {
          "type": "string",
          "maxLength": 120,
          "description": "Author or editor name."
        },
        "status": {
          "type": "string",
          "enum": ["published", "draft"],
          "description": "Publication status."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp."
        }
      },
      "required": ["id", "title", "category", "summary", "content", "authorName", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "entities/UserProfile" },
      "description": "Customer account profile, avatar, subscription status, legal type, and wallet balance."
    },
    "/users/{userId}/wallet_transactions/{txId}": {
      "schema": { "$ref": "entities/WalletTransaction" },
      "description": "Subcollection recording financial credit and debit transactions."
    },
    "/users/{userId}/notifications/{notifId}": {
      "schema": { "$ref": "entities/CustomerNotification" },
      "description": "Subcollection storing in-app customer notifications."
    },
    "/users/{userId}/family_tree/{treeId}": {
      "schema": { "$ref": "entities/FamilyTreeDocument" },
      "description": "Subcollection storing interactive family tree data (شجرتي)."
    },
    "/customer_orders/{orderId}": {
      "schema": { "$ref": "entities/CustomerOrder" },
      "description": "Real customer orders and lineage search records managed in /Team."
    },
    "/research_tickets/{ticketId}": {
      "schema": { "$ref": "entities/ResearchTicket" },
      "description": "Genealogical research and enrichment tickets."
    },
    "/team_members/{memberId}": {
      "schema": { "$ref": "entities/TeamMember" },
      "description": "Isolated /Team staff and RBAC accounts."
    },
    "/knowledge_articles/{articleId}": {
      "schema": { "$ref": "entities/KnowledgeArticle" },
      "description": "Articles and studies for the Knowledge Center."
    }
  }
}
