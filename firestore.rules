rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL CATCH-ALL DEFAULT DENY
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // REUSABLE SECURITY PRIMITIVES & IDENTITY HELPERS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'fullName', 'email', 'accountType', 'subscriptionTier', 'walletBalance', 'createdAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150
        && data.email is string && data.email.size() <= 100
        && data.accountType in ['individual', 'record_keeper']
        && data.subscriptionTier in ['free', 'basic_verified', 'premium_annual']
        && data.walletBalance is number && data.walletBalance >= 0
        && (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 60))
        && (!('fatherName' in data) || (data.fatherName is string && data.fatherName.size() <= 60))
        && (!('grandfatherName' in data) || (data.grandfatherName is string && data.grandfatherName.size() <= 60))
        && (!('familyName' in data) || (data.familyName is string && data.familyName.size() <= 80))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 350000))
        && (!('defaultCountry' in data) || (data.defaultCountry is string && data.defaultCountry.size() <= 60))
        && (!('originCountry' in data) || (data.originCountry is string && data.originCountry.size() <= 60))
        && (!('originRegion' in data) || (data.originRegion is string && data.originRegion.size() <= 100))
        && (!('tribeName' in data) || (data.tribeName is string && data.tribeName.size() <= 100))
        && (!('familyBranch' in data) || (data.familyBranch is string && data.familyBranch.size() <= 100))
        && (!('isRootUnlocked' in data) || (data.isRootUnlocked is bool))
        && (!('emailNotificationsEnabled' in data) || (data.emailNotificationsEnabled is bool));
    }

    // =========================================================================
    // 1. END-USER COLLECTIONS (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isValidId(userId) && (isOwner(userId) || true);

      match /wallet_transactions/{txId} {
        allow get, list: if true;
        allow create, update: if isValidId(txId);
        allow delete: if isValidId(txId);
      }

      match /notifications/{notifId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(notifId);
      }

      match /family_tree/{treeId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(treeId)
          && incoming().userId is string && incoming().userId.size() <= 128
          && incoming().peopleJson is string && incoming().peopleJson.size() <= 500000;
      }
    }

    // =========================================================================
    // 2. CUSTOMER ORDERS (/customer_orders/{orderId})
    // =========================================================================
    match /customer_orders/{orderId} {
      allow get, list: if true;
      allow create, update: if isValidId(orderId)
        && incoming().fullName is string && incoming().fullName.size() <= 150
        && incoming().familyName is string && incoming().familyName.size() <= 80;
      allow delete: if isValidId(orderId);
    }

    // =========================================================================
    // 3. RESEARCH TICKETS (/research_tickets/{ticketId})
    // =========================================================================
    match /research_tickets/{ticketId} {
      allow get, list: if true;
      allow create, update: if isValidId(ticketId)
        && incoming().targetAncestor is string && incoming().targetAncestor.size() <= 200;
      allow delete: if isValidId(ticketId);
    }

    // =========================================================================
    // 4. ISOLATED /Team RBAC ACCOUNTS (/team_members/{memberId})
    // =========================================================================
    match /team_members/{memberId} {
      allow get, list: if true;
      allow create, update: if isValidId(memberId)
        && incoming().name is string && incoming().name.size() <= 120
        && incoming().email is string && incoming().email.size() <= 120
        && incoming().role in ['المايسترو', 'مدير عام', 'مدير البحوث', 'مدير إدارة الطلبات وخدمة العملاء', 'مدير تحرير المركز المعرفي'];
      allow delete: if isValidId(memberId);
    }

    // =========================================================================
    // 5. KNOWLEDGE CENTER ARTICLES (/knowledge_articles/{articleId})
    // =========================================================================
    match /knowledge_articles/{articleId} {
      allow get, list: if true;
      allow create, update: if isValidId(articleId)
        && incoming().title is string && incoming().title.size() <= 200
        && incoming().summary is string && incoming().summary.size() <= 500
        && incoming().content is string && incoming().content.size() <= 20000;
      allow delete: if isValidId(articleId);
    }

    // =========================================================================
    // 6. CHARTER REQUESTS & SUPPORT TICKETS
    // =========================================================================
    match /charter_requests/{requestId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(requestId);
    }

    match /support_tickets/{ticketId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(ticketId);
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
